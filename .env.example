# OpenAI-compatible endpoint serving a Meta model.
# Baseten hackathon endpoint (Muse Spark Open). The key only works with this exact model name.
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026
LLM_API_KEY=your_api_key_here
# Optional: low | medium | high | xhigh (Baseten default xhigh is slow)
LLM_REASONING_EFFORT=medium
